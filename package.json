{
  "name": "serpent-cosmique",
  "version": "1.0.0",
  "description": "Jeu de serpent coloré, installable sur téléphone et jouable sans connexion.",
  "private": true,
  "license": "MIT",
  "author": "CocoClaudo",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.sw.json --noEmit",
    "test": "node --test --test-coverage-include=\"src/core/**\" --test-coverage-lines=80 --experimental-test-coverage tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "serve": "node scripts/serve.mjs"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
